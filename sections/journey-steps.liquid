<section class="balance-section common-padding" id="balance-section-{{ section.id }}">
  <div class="container">
    <div class="section-heading-content">
      <h2>
        {%- if section.settings.heading != blank -%}
          {{ section.settings.heading | replace: '*', '<span class="italic">' | replace: '</span>*', '</span>' }}
        {%- else -%}
          Your Journey to <span class="italic">Better Balance</span>
        {%- endif -%}
      </h2>
      {%- if section.settings.subheading != blank -%}
        <p>{{ section.settings.subheading | escape }}</p>
      {%- endif -%}
    </div>

    <div class="balance-row">
      {%- if section.blocks.size > 0 -%}
        {%- for block in section.blocks -%}
          <div class="balance-col" {{ block.shopify_attributes }}>
            <div class="balance-box">
              <div class="balance-img">
                {%- if block.settings.image != blank -%}
                  <img
                    src="{{ block.settings.image | image_url: width: 600 }}"
                    alt="{{ block.settings.title | escape }}"
                    loading="lazy"
                    width="{{ block.settings.image.width }}"
                    height="{{ block.settings.image.height }}"
                  />
                {%- else -%}
                  {%- assign fallback_img = 'balance-img' | append: forloop.index | append: '.png' -%}
                  <img
                    src="{{ fallback_img | asset_url }}"
                    alt="{{ block.settings.title | escape }}"
                    loading="lazy"
                    width="280"
                    height="320"
                  />
                {%- endif -%}
                <div class="balance-step">
                  <span class="italic">{{ block.settings.step_number | default: forloop.index }}</span>
                </div>
              </div>
              <div class="balance-content">
                <h3>
                  <span class="italic">{{ block.settings.title | escape }}</span>
                </h3>
                <p>{{ block.settings.text | escape }}</p>
              </div>
            </div>
          </div>
        {%- endfor -%}
      {%- else -%}
        <div class="balance-col">
          <div class="balance-box">
            <div class="balance-img">
              <img src="{{ 'balance-img1.png' | asset_url }}" alt="Step 1" loading="lazy" width="280" height="320" />
              <div class="balance-step"><span class="italic">1</span></div>
            </div>
            <div class="balance-content">
              <h3><span class="italic">Order Your Gummies</span></h3>
              <p>Take advantage of our fast, free delivery and get your gummies in days,</p>
            </div>
          </div>
        </div>
        <div class="balance-col">
          <div class="balance-box">
            <div class="balance-img">
              <img src="{{ 'balance-img2.png' | asset_url }}" alt="Step 2" loading="lazy" width="280" height="320" />
              <div class="balance-step"><span class="italic">2</span></div>
            </div>
            <div class="balance-content">
              <h3><span class="italic">Start Your Daily Ritual</span></h3>
              <p>Receive your premium bottle and enjoy two delicious gummies every morning.</p>
            </div>
          </div>
        </div>
        <div class="balance-col">
          <div class="balance-box">
            <div class="balance-img">
              <img src="{{ 'balance-img3.png' | asset_url }}" alt="Step 3" loading="lazy" width="280" height="320" />
              <div class="balance-step"><span class="italic">3</span></div>
            </div>
            <div class="balance-content">
              <h3><span class="italic">Reclaim Your Vibrant Self</span></h3>
              <p>Experience steady energy and a balanced mood that lasts from dawn until dusk.</p>
            </div>
          </div>
        </div>
      {%- endif -%}
    </div>

    {%- if section.settings.button_label != blank or section.settings.show_rating -%}
      <div class="balance-cta-section">
        {%- if section.settings.button_label != blank -%}
          <a href="{{ section.settings.button_link | default: '#product-showcase' }}" class="btn btn-primary">
            {{ section.settings.button_label | escape }}
            <span class="btn-img">
              <img src="{{ 'btn-plus.svg' | asset_url }}" alt="" width="14" height="14" />
            </span>
          </a>
        {%- endif -%}

        {%- if section.settings.show_rating -%}
          <div class="rating">
            <ul>
              {%- for i in (1..5) -%}
                <li>
                  <img src="{{ 'rating-star.svg' | asset_url }}" alt="Star" width="16" height="16" />
                </li>
              {%- endfor -%}
            </ul>
            <p>
              <span class="bold">{{ section.settings.rating_score | default: '4.8/5' }} </span>
              <span class="underline">{{ section.settings.rating_text | default: '(see what 324 people said)' }}</span>
            </p>
          </div>
        {%- endif -%}
      </div>
    {%- endif -%}
  </div>
</section>

{% schema %}
{
  "name": "Journey to Balance",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Your Journey to *Better Balance*",
      "info": "Surround words with asterisks for italic styling, e.g. *Better Balance*"
    },
    {
      "type": "textarea",
      "id": "subheading",
      "label": "Subheading",
      "default": "Three simple steps to transition from feeling burnt out to feeling completely revitalized."
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "Button Label",
      "default": "Order Yours Now"
    },
    {
      "type": "url",
      "id": "button_link",
      "label": "Button Link"
    },
    {
      "type": "checkbox",
      "id": "show_rating",
      "label": "Show Rating",
      "default": true
    },
    {
      "type": "text",
      "id": "rating_score",
      "label": "Rating Score",
      "default": "4.8/5"
    },
    {
      "type": "text",
      "id": "rating_text",
      "label": "Rating Text",
      "default": "(see what 324 people said)"
    }
  ],
  "blocks": [
    {
      "type": "step",
      "name": "Step Item",
      "settings": [
        {
          "type": "image_picker",
          "id": "image",
          "label": "Step Image"
        },
        {
          "type": "text",
          "id": "step_number",
          "label": "Step Number",
          "default": "1"
        },
        {
          "type": "text",
          "id": "title",
          "label": "Title",
          "default": "Order Your Gummies"
        },
        {
          "type": "textarea",
          "id": "text",
          "label": "Description",
          "default": "Take advantage of our fast, free delivery and get your gummies in days,"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Journey to Balance",
      "blocks": [
        {
          "type": "step",
          "settings": {
            "step_number": "1",
            "title": "Order Your Gummies",
            "text": "Take advantage of our fast, free delivery and get your gummies in days,"
          }
        },
        {
          "type": "step",
          "settings": {
            "step_number": "2",
            "title": "Start Your Daily Ritual",
            "text": "Receive your premium bottle and enjoy two delicious gummies every morning."
          }
        },
        {
          "type": "step",
          "settings": {
            "step_number": "3",
            "title": "Reclaim Your Vibrant Self",
            "text": "Experience steady energy and a balanced mood that lasts from dawn until dusk."
          }
        }
      ]
    }
  ]
}
{% endschema %}
