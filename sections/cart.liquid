<div class="container common-padding cart-page" style="min-height: 50vh;">
  <div class="section-heading-content" style="margin-bottom: 3.2rem;">
    <h1><span class="italic">{{ 'cart.title' | t }}</span></h1>
  </div>

  {% if cart.item_count > 0 %}
    <form action="{{ routes.cart_url }}" method="post" class="cart-form">
      <div class="cart-table-wrapper" style="overflow-x: auto; margin-bottom: 3.2rem;">
        <table style="width: 100%; border-collapse: collapse; text-align: left;">
          <thead>
            <tr style="border-bottom: 2px solid #eee; padding-bottom: 1rem;">
              <th style="padding: 1.2rem; font-size: 1.4rem; text-transform: uppercase;">Product</th>
              <th style="padding: 1.2rem; font-size: 1.4rem; text-transform: uppercase;">Price</th>
              <th style="padding: 1.2rem; font-size: 1.4rem; text-transform: uppercase; text-align: center;">Quantity</th>
              <th style="padding: 1.2rem; font-size: 1.4rem; text-transform: uppercase; text-align: right;">Total</th>
            </tr>
          </thead>
          <tbody>
            {% for item in cart.items %}
              <tr style="border-bottom: 1px solid #f0f0f0;">
                <td style="padding: 1.6rem 1.2rem; display: flex; align-items: center; gap: 1.6rem;">
                  {% if item.image %}
                    <a href="{{ item.url }}">
                      <img src="{{ item.image | image_url: width: 160 }}" alt="{{ item.title | escape }}" width="80" height="80" style="border-radius: 8px; object-fit: cover;">
                    </a>
                  {% endif %}
                  <div>
                    <a href="{{ item.url }}" style="font-weight: 600; font-size: 1.6rem; color: inherit; text-decoration: none;">{{ item.product.title }}</a>
                    {% unless item.product.has_only_default_variant %}
                      <p style="font-size: 1.3rem; color: #666; margin-top: 0.4rem;">{{ item.variant.title }}</p>
                    {% endunless %}
                    <p style="margin-top: 0.6rem;">
                      <a href="{{ item.url_to_remove }}" style="font-size: 1.2rem; color: #d9534f; text-decoration: underline;">{{ 'cart.remove' | t }}</a>
                    </p>
                  </div>
                </td>
                <td style="padding: 1.6rem 1.2rem; font-size: 1.5rem; font-weight: 600;">
                  {{ item.final_price | money }}
                </td>
                <td style="padding: 1.6rem 1.2rem; text-align: center;">
                  <input
                    type="number"
                    name="updates[]"
                    value="{{ item.quantity }}"
                    min="0"
                    aria-label="Quantity for {{ item.title | escape }}"
                    style="width: 6rem; text-align: center; padding: 0.6rem; border: 1px solid #ccc; border-radius: 6px; font-size: 1.4rem;"
                  >
                </td>
                <td style="padding: 1.6rem 1.2rem; font-size: 1.5rem; font-weight: 700; text-align: right;">
                  {{ item.final_line_price | money }}
                </td>
              </tr>
            {% endfor %}
          </tbody>
        </table>
      </div>

      <div class="cart-footer-actions" style="display: flex; flex-wrap: wrap; justify-content: space-between; align-items: flex-end; gap: 2rem;">
        <div>
          <button type="submit" name="update" class="btn" style="background: #f4f4f4; color: #333; border: 1px solid #ddd; padding: 1.2rem 2.4rem; border-radius: 50px; font-weight: 600; cursor: pointer;">
            {{ 'cart.update' | t }}
          </button>
        </div>
        <div style="text-align: right;">
          <p style="font-size: 1.8rem; margin-bottom: 0.8rem;">
            <span>Subtotal:</span>
            <span style="font-weight: 700; font-size: 2.2rem; margin-left: 1rem;">{{ cart.total_price | money }}</span>
          </p>
          <p style="font-size: 1.3rem; color: #666; margin-bottom: 1.6rem;">Taxes and shipping calculated at checkout</p>
          <button type="submit" name="checkout" class="btn" style="background: #df5353; color: #fff; border-radius: 50px; padding: 1.4rem 4rem; border: none; cursor: pointer; font-weight: 600; font-size: 1.6rem; transition: opacity 0.2s ease;">
            {{ 'cart.checkout' | t }}
          </button>
        </div>
      </div>
    </form>
  {% else %}
    <div style="text-align: center; padding: 6rem 0;">
      <p style="font-size: 1.8rem; color: #666; margin-bottom: 2.4rem;">Your cart is currently empty.</p>
      <a href="{{ routes.all_products_collection_url }}" class="btn" style="display: inline-block; background: #df5353; color: #fff; padding: 1.4rem 3.6rem; border-radius: 50px; font-weight: 600; text-decoration: none; font-size: 1.5rem;">
        {{ '404.back_to_shopping' | t }}
      </a>
    </div>
  {% endif %}
</div>

{% schema %}
{
  "name": "t:general.cart",
  "settings": []
}
{% endschema %}
