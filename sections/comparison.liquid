<section class="revitae-section common-padding" id="comparison-{{ section.id }}">
  <div class="container">
    <div class="section-heading-content">
      <h2>
        {%- if section.settings.heading != blank -%}
          {{ section.settings.heading | replace: '*', '<span class="italic">' | replace: '</span>*', '</span>' }}
        {%- else -%}
          How Revitae <span class="italic">Stands Alone</span>
        {%- endif -%}
      </h2>
      {%- if section.settings.subheading != blank -%}
        <p>{{ section.settings.subheading | escape }}</p>
      {%- endif -%}
    </div>

    <div class="revitae-comparison-container">
      <div class="revitae-comparison-wrapper">
        <!-- Left Column: Labels -->
        <div class="comparison-labels">
          {%- if section.blocks.size > 0 -%}
            {%- for block in section.blocks -%}
              <div class="comparison-label-item" {{ block.shopify_attributes }}>
                {{ block.settings.label | escape }}
              </div>
            {%- endfor -%}
          {%- else -%}
            <div class="comparison-label-item">Targeted Support</div>
            <div class="comparison-label-item">Ingredient Purity</div>
            <div class="comparison-label-item">Sleep Quality</div>
            <div class="comparison-label-item">Energy Delivery</div>
            <div class="comparison-label-item">Taste &amp; Texture</div>
            <div class="comparison-label-item">Sustainability</div>
          {%- endif -%}
        </div>

        <!-- Cards Group -->
        <div class="comparison-cards-group">
          <!-- Middle Column: Revitae Highlight Card -->
          <div class="comparison-card revitae-card">
            <div class="comparison-card-header">
              {%- if section.settings.brand_logo != blank -%}
                <img
                  src="{{ section.settings.brand_logo | image_url: width: 200 }}"
                  alt="{{ shop.name | escape }}"
                  class="brand-logo"
                  width="{{ section.settings.brand_logo.width }}"
                  height="{{ section.settings.brand_logo.height }}"
                />
              {%- else -%}
                <img
                  src="{{ 'logo.png' | asset_url }}"
                  alt="Revitae"
                  class="brand-logo"
                  width="120"
                  height="30"
                />
              {%- endif -%}
            </div>
            <div class="comparison-card-body">
              {%- if section.blocks.size > 0 -%}
                {%- for block in section.blocks -%}
                  <div class="comparison-row">
                    <div class="row-icon-wrap">
                      <img src="{{ 'white-check.svg' | asset_url }}" alt="" width="16" height="16" />
                    </div>
                    <span class="row-text">{{ block.settings.revitae_text | escape }}</span>
                  </div>
                {%- endfor -%}
              {%- else -%}
                <div class="comparison-row">
                  <div class="row-icon-wrap"><img src="{{ 'white-check.svg' | asset_url }}" alt="" width="16" height="16" /></div>
                  <span class="row-text">Specific ingredients for female endocrine balance</span>
                </div>
                <div class="comparison-row">
                  <div class="row-icon-wrap"><img src="{{ 'white-check.svg' | asset_url }}" alt="" width="16" height="16" /></div>
                  <span class="row-text">Zero artificial fillers or synthetic dyes</span>
                </div>
                <div class="comparison-row">
                  <div class="row-icon-wrap"><img src="{{ 'white-check.svg' | asset_url }}" alt="" width="16" height="16" /></div>
                  <span class="row-text">Promotes deep, REM-cycle restorative sleep</span>
                </div>
                <div class="comparison-row">
                  <div class="row-icon-wrap"><img src="{{ 'white-check.svg' | asset_url }}" alt="" width="16" height="16" /></div>
                  <span class="row-text">Steady, non-stimulant daily energy support</span>
                </div>
                <div class="comparison-row">
                  <div class="row-icon-wrap"><img src="{{ 'white-check.svg' | asset_url }}" alt="" width="16" height="16" /></div>
                  <span class="row-text">Premium, soft-chew botanical experience</span>
                </div>
                <div class="comparison-row">
                  <div class="row-icon-wrap"><img src="{{ 'white-check.svg' | asset_url }}" alt="" width="16" height="16" /></div>
                  <span class="row-text">Ethically sourced and eco-friendly packaging</span>
                </div>
              {%- endif -%}
            </div>
          </div>

          <!-- Right Column: Generic Pharmacy Brand Card -->
          <div class="comparison-card generic-card">
            <div class="comparison-card-header">
              <span class="generic-brand-title">
                {{ section.settings.generic_title | default: 'GENERIC PHARMACY BRAND' }}
              </span>
            </div>
            <div class="comparison-card-body pharmacy-brand">
              {%- if section.blocks.size > 0 -%}
                {%- for block in section.blocks -%}
                  <div class="comparison-row">
                    <div class="row-icon-wrap generic-icon">
                      <img src="{{ 'cross-icon.svg' | asset_url }}" alt="" width="16" height="16" />
                    </div>
                    <span class="row-text">{{ block.settings.generic_text | escape }}</span>
                  </div>
                {%- endfor -%}
              {%- else -%}
                <div class="comparison-row">
                  <div class="row-icon-wrap generic-icon"><img src="{{ 'cross-icon.svg' | asset_url }}" alt="" width="16" height="16" /></div>
                  <span class="row-text">General multi-vitamin with no specific focus</span>
                </div>
                <div class="comparison-row">
                  <div class="row-icon-wrap generic-icon"><img src="{{ 'cross-icon.svg' | asset_url }}" alt="" width="16" height="16" /></div>
                  <span class="row-text">Often contains corn syrup and FD&amp;C colors</span>
                </div>
                <div class="comparison-row">
                  <div class="row-icon-wrap generic-icon"><img src="{{ 'cross-icon.svg' | asset_url }}" alt="" width="16" height="16" /></div>
                  <span class="row-text">No specific sleep-inducing botanicals included</span>
                </div>
                <div class="comparison-row">
                  <div class="row-icon-wrap generic-icon"><img src="{{ 'cross-icon.svg' | asset_url }}" alt="" width="16" height="16" /></div>
                  <span class="row-text">Often relies on B-Vitamin spikes only</span>
                </div>
                <div class="comparison-row">
                  <div class="row-icon-wrap generic-icon"><img src="{{ 'cross-icon.svg' | asset_url }}" alt="" width="16" height="16" /></div>
                  <span class="row-text">Rubbery, overly sweet "candy" feel</span>
                </div>
                <div class="comparison-row">
                  <div class="row-icon-wrap generic-icon"><img src="{{ 'cross-icon.svg' | asset_url }}" alt="" width="16" height="16" /></div>
                  <span class="row-text">Mass-produced with little environmental oversight</span>
                </div>
              {%- endif -%}
            </div>
          </div>
        </div>
      </div>
    </div>

    <!-- CTA Button & Rating Section -->
    {%- if section.settings.button_label != blank or section.settings.show_rating -%}
      <div class="balance-cta-section revitae-cta-section">
        {%- if section.settings.button_label != blank -%}
          <a href="{{ section.settings.button_link | default: '#product-showcase' }}" class="btn btn-primary">
            {{ section.settings.button_label | escape }}
            <span class="btn-img">
              <img src="{{ 'btn-plus.svg' | asset_url }}" alt="" width="14" height="14" />
            </span>
          </a>
        {%- endif -%}

        {%- if section.settings.show_rating -%}
          <div class="rating">
            <ul>
              {%- for i in (1..5) -%}
                <li><img src="{{ 'rating-star.svg' | asset_url }}" alt="Star" width="16" height="16" /></li>
              {%- endfor -%}
            </ul>
            <p>
              <span class="bold">{{ section.settings.rating_score | default: '4.8/5' }} </span>
              <span class="underline">{{ section.settings.rating_text | default: '(see what 324 people said)' }}</span>
            </p>
          </div>
        {%- endif -%}
      </div>
    {%- endif -%}
  </div>
</section>

{% schema %}
{
  "name": "Comparison Table",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "How Revitae *Stands Alone*",
      "info": "Surround words with asterisks for italic styling, e.g. *Stands Alone*"
    },
    {
      "type": "textarea",
      "id": "subheading",
      "label": "Subheading",
      "default": "Don't settle for \"standard\" when your health deserves the absolute gold standard."
    },
    {
      "type": "image_picker",
      "id": "brand_logo",
      "label": "Brand Logo"
    },
    {
      "type": "text",
      "id": "generic_title",
      "label": "Generic Column Title",
      "default": "GENERIC PHARMACY BRAND"
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "Button Label",
      "default": "Order Yours Now"
    },
    {
      "type": "url",
      "id": "button_link",
      "label": "Button Link"
    },
    {
      "type": "checkbox",
      "id": "show_rating",
      "label": "Show Rating",
      "default": true
    },
    {
      "type": "text",
      "id": "rating_score",
      "label": "Rating Score",
      "default": "4.8/5"
    },
    {
      "type": "text",
      "id": "rating_text",
      "label": "Rating Text",
      "default": "(see what 324 people said)"
    }
  ],
  "blocks": [
    {
      "type": "comparison_row",
      "name": "Comparison Feature Row",
      "settings": [
        {
          "type": "text",
          "id": "label",
          "label": "Feature Label",
          "default": "Targeted Support"
        },
        {
          "type": "text",
          "id": "revitae_text",
          "label": "Revitae Text",
          "default": "Specific ingredients for female endocrine balance"
        },
        {
          "type": "text",
          "id": "generic_text",
          "label": "Generic Brand Text",
          "default": "General multi-vitamin with no specific focus"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Comparison Table",
      "blocks": [
        {
          "type": "comparison_row",
          "settings": {
            "label": "Targeted Support",
            "revitae_text": "Specific ingredients for female endocrine balance",
            "generic_text": "General multi-vitamin with no specific focus"
          }
        },
        {
          "type": "comparison_row",
          "settings": {
            "label": "Ingredient Purity",
            "revitae_text": "Zero artificial fillers or synthetic dyes",
            "generic_text": "Often contains corn syrup and FD&C colors"
          }
        },
        {
          "type": "comparison_row",
          "settings": {
            "label": "Sleep Quality",
            "revitae_text": "Promotes deep, REM-cycle restorative sleep",
            "generic_text": "No specific sleep-inducing botanicals included"
          }
        },
        {
          "type": "comparison_row",
          "settings": {
            "label": "Energy Delivery",
            "revitae_text": "Steady, non-stimulant daily energy support",
            "generic_text": "Often relies on B-Vitamin spikes only"
          }
        },
        {
          "type": "comparison_row",
          "settings": {
            "label": "Taste & Texture",
            "revitae_text": "Premium, soft-chew botanical experience",
            "generic_text": "Rubbery, overly sweet \"candy\" feel"
          }
        },
        {
          "type": "comparison_row",
          "settings": {
            "label": "Sustainability",
            "revitae_text": "Ethically sourced and eco-friendly packaging",
            "generic_text": "Mass-produced with little environmental oversight"
          }
        }
      ]
    }
  ]
}
{% endschema %}
