<section class="commitment common-padding" id="commitment-{{ section.id }}">
  <div class="container">
    <div class="commitment-content-wrapper">
      <div class="section-heading-content">
        <h2>
          {%- if section.settings.heading != blank -%}
            {{ section.settings.heading | replace: '*', '<span class="italic">' | replace: '</span>*', '</span>' }}
          {%- else -%}
            Our Commitment <span class="italic">to You</span>
          {%- endif -%}
        </h2>
        {%- if section.settings.subheading != blank -%}
          <p>{{ section.settings.subheading | escape }}</p>
        {%- endif -%}
      </div>

      <div class="commitment-row">
        {%- assign commitment_blocks = section.blocks | where: 'type', 'commitment_item' -%}
        {%- if commitment_blocks.size > 0 -%}
          {%- for block in commitment_blocks -%}
            <div class="commitment-col" {{ block.shopify_attributes }}>
              <div class="commitment-box">
                <div class="commitment-img">
                  {%- if block.settings.icon != blank -%}
                    <img
                      src="{{ block.settings.icon | image_url: width: 120 }}"
                      alt="{{ block.settings.title | escape }}"
                      loading="lazy"
                      width="{{ block.settings.icon.width }}"
                      height="{{ block.settings.icon.height }}"
                    />
                  {%- else -%}
                    {%- assign fallback_icon = 'commitment-icon' | append: forloop.index | append: '.svg' -%}
                    <img
                      src="{{ fallback_icon | asset_url }}"
                      alt="{{ block.settings.title | escape }}"
                      loading="lazy"
                      width="50"
                      height="50"
                    />
                  {%- endif -%}
                </div>
                <div class="commitment-content">
                  <h3>
                    <span class="italic">{{ block.settings.title | escape }}</span>
                  </h3>
                  <p>{{ block.settings.description | escape }}</p>
                </div>
              </div>
            </div>
          {%- endfor -%}
        {%- else -%}
          <div class="commitment-col">
            <div class="commitment-box">
              <div class="commitment-img">
                <img src="{{ 'commitment-icon1.svg' | asset_url }}" alt="" loading="lazy" width="50" height="50" />
              </div>
              <div class="commitment-content">
                <h3><span class="italic">Ethically Sourced Ingredients</span></h3>
                <p>We partner with sustainable farms to ensure every botanical in Revitae is potent, pure, and harvested with respect for the planet.</p>
              </div>
            </div>
          </div>
          <div class="commitment-col">
            <div class="commitment-box">
              <div class="commitment-img">
                <img src="{{ 'commitment-icon2.svg' | asset_url }}" alt="" loading="lazy" width="50" height="50" />
              </div>
              <div class="commitment-content">
                <h3><span class="italic">Formulated By Experts</span></h3>
                <p>Our gummies are designed by leading nutritionists to ensure the dosage is effective for the unique needs of the female body.</p>
              </div>
            </div>
          </div>
          <div class="commitment-col">
            <div class="commitment-box">
              <div class="commitment-img">
                <img src="{{ 'commitment-icon3.svg' | asset_url }}" alt="" loading="lazy" width="50" height="50" />
              </div>
              <div class="commitment-content">
                <h3><span class="italic">Clean Label Promise</span></h3>
                <p>You will never find artificial dyes, fillers, or synthetic binders in our products—only what your body needs to thrive.</p>
              </div>
            </div>
          </div>
        {%- endif -%}
      </div>

      {%- if section.settings.button_label != blank or section.settings.show_rating -%}
        <div class="commitment-cta-btn">
          {%- if section.settings.button_label != blank -%}
            <a href="{{ section.settings.button_link | default: '#product-showcase' }}" class="btn btn-primary">
              {{ section.settings.button_label | escape }}
              <span class="btn-img">
                <img src="{{ 'btn-plus.svg' | asset_url }}" alt="" width="14" height="14" />
              </span>
            </a>
          {%- endif -%}

          {%- if section.settings.show_rating -%}
            <div class="rating">
              <ul>
                {%- for i in (1..5) -%}
                  <li><img src="{{ 'rating-star.svg' | asset_url }}" alt="Star" width="16" height="16" /></li>
                {%- endfor -%}
              </ul>
              <p>
                <span class="bold">{{ section.settings.rating_score | default: '4.8/5' }} </span>
                <span class="underline">{{ section.settings.rating_text | default: '(see what 324 people said)' }}</span>
              </p>
            </div>
          {%- endif -%}
        </div>
      {%- endif -%}
    </div>
  </div>

  <div class="commitment-slider">
    <div class="swiper commitment-swiper">
      <div class="swiper-wrapper">
        {%- assign video_blocks = section.blocks | where: 'type', 'video_slide' -%}
        {%- if video_blocks.size > 0 -%}
          {%- for block in video_blocks -%}
            <div class="swiper-slide" {{ block.shopify_attributes }}>
              <div class="video-card">
                {%- assign video_src = block.settings.video_url -%}
                {%- if video_src == blank -%}
                  {%- assign video_src = 'demo-video.mp4' | asset_url -%}
                {%- endif -%}
                {%- assign poster_src = 'banner-img.png' | asset_url -%}
                {%- if block.settings.poster != blank -%}
                  {%- assign poster_src = block.settings.poster | image_url: width: 600 -%}
                {%- endif -%}
                <video
                  src="{{ video_src }}"
                  poster="{{ poster_src }}"
                  playsinline
                  preload="metadata"
                ></video>
                <div class="play-btn-overlay">
                  <button class="play-btn" type="button" aria-label="Play video">
                    <img src="{{ 'play-btn.svg' | asset_url }}" alt="" width="48" height="48" />
                  </button>
                </div>
              </div>
            </div>
          {%- endfor -%}
        {%- else -%}
          {%- for i in (1..8) -%}
            <div class="swiper-slide">
              <div class="video-card">
                <video
                  src="{{ 'demo-video.mp4' | asset_url }}"
                  poster="{{ 'banner-img.png' | asset_url }}"
                  playsinline
                  preload="metadata"
                ></video>
                <div class="play-btn-overlay">
                  <button class="play-btn" type="button" aria-label="Play video">
                    <img src="{{ 'play-btn.svg' | asset_url }}" alt="" width="48" height="48" />
                  </button>
                </div>
              </div>
            </div>
          {%- endfor -%}
        {%- endif -%}
      </div>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Commitment & Video Slider",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Our Commitment *to You*",
      "info": "Surround words with asterisks for italic styling, e.g. *to You*"
    },
    {
      "type": "textarea",
      "id": "subheading",
      "label": "Subheading",
      "default": "We believe in transparency, ethics, and providing women with superior wellness tools."
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "Button Label",
      "default": "Order Yours Now"
    },
    {
      "type": "url",
      "id": "button_link",
      "label": "Button Link"
    },
    {
      "type": "checkbox",
      "id": "show_rating",
      "label": "Show Rating",
      "default": true
    },
    {
      "type": "text",
      "id": "rating_score",
      "label": "Rating Score",
      "default": "4.8/5"
    },
    {
      "type": "text",
      "id": "rating_text",
      "label": "Rating Text",
      "default": "(see what 324 people said)"
    }
  ],
  "blocks": [
    {
      "type": "commitment_item",
      "name": "Commitment Pillar",
      "settings": [
        {
          "type": "image_picker",
          "id": "icon",
          "label": "Icon"
        },
        {
          "type": "text",
          "id": "title",
          "label": "Title",
          "default": "Ethically Sourced Ingredients"
        },
        {
          "type": "textarea",
          "id": "description",
          "label": "Description",
          "default": "We partner with sustainable farms to ensure every botanical in Revitae is potent, pure, and harvested with respect for the planet."
        }
      ]
    },
    {
      "type": "video_slide",
      "name": "Video Slide",
      "settings": [
        {
          "type": "text",
          "id": "video_url",
          "label": "Video URL (.mp4)",
          "info": "Leave blank to use default demo video"
        },
        {
          "type": "image_picker",
          "id": "poster",
          "label": "Poster Image"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Commitment & Video Slider",
      "blocks": [
        {
          "type": "commitment_item",
          "settings": {
            "title": "Ethically Sourced Ingredients",
            "description": "We partner with sustainable farms to ensure every botanical in Revitae is potent, pure, and harvested with respect for the planet."
          }
        },
        {
          "type": "commitment_item",
          "settings": {
            "title": "Formulated By Experts",
            "description": "Our gummies are designed by leading nutritionists to ensure the dosage is effective for the unique needs of the female body."
          }
        },
        {
          "type": "commitment_item",
          "settings": {
            "title": "Clean Label Promise",
            "description": "You will never find artificial dyes, fillers, or synthetic binders in our products—only what your body needs to thrive."
          }
        },
        { "type": "video_slide" },
        { "type": "video_slide" },
        { "type": "video_slide" },
        { "type": "video_slide" },
        { "type": "video_slide" },
        { "type": "video_slide" },
        { "type": "video_slide" },
        { "type": "video_slide" }
      ]
    }
  ]
}
{% endschema %}
