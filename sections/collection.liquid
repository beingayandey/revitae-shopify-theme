<div class="container common-padding">
  <div class="section-heading-content" style="text-align: center; margin-bottom: 3.2rem;">
    <h2><span class="italic">{{ collection.title | escape }}</span></h2>
    {% if collection.description != blank %}
      <p>{{ collection.description }}</p>
    {% endif %}
  </div>

  <div class="collection-products">
    {% paginate collection.products by 24 %}
      <div class="collection-grid" style="display: grid; grid-template-columns: repeat(auto-fill, minmax(250px, 1fr)); gap: 2rem;">
        {% for product in collection.products %}
          {% render 'product-card', product: product %}
        {% else %}
          <p style="grid-column: 1 / -1; text-align: center; font-size: 1.6rem;">No products found in this collection.</p>
        {% endfor %}
      </div>

      {% if paginate.pages > 1 %}
        <div class="pagination-wrapper" style="margin-top: 3.2rem; text-align: center;">
          {{ paginate | default_pagination }}
        </div>
      {% endif %}
    {% endpaginate %}
  </div>
</div>

{% schema %}
{
  "name": "Collection Products",
  "settings": []
}
{% endschema %}
