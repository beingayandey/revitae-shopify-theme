          {%- endfor -%}
        {%- endif -%}
      </div>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Results & Testimonials",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Real Women with *Real Results*",
      "info": "Surround words with asterisks for italic styling, e.g. *Real Results*"
    },
    {
      "type": "textarea",
      "id": "subheading",
      "label": "Subheading",
      "default": "Hear from the thousands of women who have found their balance again."
    }
  ],
  "blocks": [
    {
      "type": "testimonial",
      "name": "Testimonial Card",
      "settings": [
        {
          "type": "image_picker",
          "id": "avatar",
          "label": "Customer Photo / Avatar"
        },
        {
          "type": "text",
          "id": "quote_intro",
          "label": "Quote Opening Text",
          "default": "\"I was skeptical about gummies, but after two weeks, "
        },
        {
          "type": "text",
          "id": "quote_highlight",
          "label": "Quote Highlight (Bold)",
          "default": "the 'brain fog' is gone and I'm sleeping through the night for the first time in years.\""
        },
        {
          "type": "text",
          "id": "name",
          "label": "Customer Name",
          "default": "Jenna M"
        },
        {
          "type": "checkbox",
          "id": "verified",
          "label": "Show Verified Customer Badge",
          "default": true
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Results & Testimonials",
      "blocks": [
        {
          "type": "testimonial",
          "settings": {
            "quote_intro": "\"I was skeptical about gummies, but after two weeks, ",
            "quote_highlight": "the 'brain fog' is gone and I'm sleeping through the night for the first time in years.\"",
            "name": "Jenna M",
            "verified": true
          }
        },
        {
          "type": "testimonial",
          "settings": {
            "quote_intro": "\"My energy levels are finally stable throughout the day. ",
            "quote_highlight": "No more 3pm crashes or restless nights!\"",
            "name": "Sarah L",
            "verified": true
          }
        },
        {
          "type": "testimonial",
          "settings": {
            "quote_intro": "\"Revitae has completely transformed my mood and focus. ",
            "quote_highlight": "I feel like myself again for the first time in ages.\"",
            "name": "Emily R",
            "verified": true
          }
        },
        {
          "type": "testimonial",
          "settings": {
            "quote_intro": "\"Noticeable difference in my sleep quality within 10 days. ",
            "quote_highlight": "Waking up refreshed every morning.\"",
            "name": "Jessica T",
            "verified": true
          }
        }
      ]
    }
  ]
}
{% endschema %}
