<section class="results-section common-padding" id="results-{{ section.id }}">
  <div class="container">
    <div class="section-heading-content">
      <h2>
        {%- if section.settings.heading != blank -%}
          {{ section.settings.heading | replace: '*', '<span class="italic">' | replace: '</span>*', '</span>' }}
        {%- else -%}
          Real Women with <span class="italic">Real Results</span>
        {%- endif -%}
      </h2>
      {%- if section.settings.subheading != blank -%}
        <p>{{ section.settings.subheading | escape }}</p>
      {%- endif -%}
    </div>
  </div>

  <!-- Edge to Edge Double Continuous Slider -->
  <div class="results-slider-wrapper">
    <!-- Top Row Slider (Moving Left) -->
    <div class="results-slider-row slider-top">
      <div class="results-track track-left">
        {%- if section.blocks.size > 0 -%}
          {%- for i in (1..2) -%}
            {%- for block in section.blocks -%}
              <div class="banner-review" {{ block.shopify_attributes }}>
                <div class="br-left">
                  {%- if block.settings.avatar != blank -%}
                    <img
                      src="{{ block.settings.avatar | image_url: width: 100 }}"
                      alt="{{ block.settings.name | escape }}"
                      loading="lazy"
                      width="{{ block.settings.avatar.width }}"
                      height="{{ block.settings.avatar.height }}"
                    />
                  {%- else -%}
                    <img
                      src="{{ 'br-img1.png' | asset_url }}"
                      alt="{{ block.settings.name | escape }}"
                      loading="lazy"
                      width="52"
                      height="52"
                    />
                  {%- endif -%}
                </div>
                <div class="br-right">
                  <p>
                    {%- if block.settings.quote_intro != blank -%}
                      {{ block.settings.quote_intro | escape }}
                    {%- endif -%}
                    {%- if block.settings.quote_highlight != blank -%}
                      <span class="bold">{{ block.settings.quote_highlight | escape }}</span>
                    {%- endif -%}
                  </p>
                  <div class="customer-name">
                    <span>{{ block.settings.name | escape }}</span>
                    {%- if block.settings.verified -%}
                      <span class="verifired-badge">
                        <img src="{{ 'white-check.svg' | asset_url }}" alt="" width="12" height="12" />
                        Verified Customer
                      </span>
                    {%- endif -%}
                  </div>
                </div>
              </div>
            {%- endfor -%}
          {%- endfor -%}
        {%- else -%}
          {%- for i in (1..2) -%}
            <div class="banner-review">
              <div class="br-left"><img src="{{ 'br-img1.png' | asset_url }}" alt="" width="52" height="52" /></div>
              <div class="br-right">
                <p>"I was skeptical about gummies, but after two weeks, <span class="bold">the 'brain fog' is gone and I'm sleeping through the night for the first time in years."</span></p>
                <div class="customer-name">
                  <span>Jenna M</span>
                  <span class="verifired-badge"><img src="{{ 'white-check.svg' | asset_url }}" alt="" width="12" height="12" /> Verified Customer</span>
                </div>
              </div>
            </div>
            <div class="banner-review">
              <div class="br-left"><img src="{{ 'br-img1.png' | asset_url }}" alt="" width="52" height="52" /></div>
              <div class="br-right">
                <p>"My energy levels are finally stable throughout the day. <span class="bold">No more 3pm crashes or restless nights!"</span></p>
                <div class="customer-name">
                  <span>Sarah L</span>
                  <span class="verifired-badge"><img src="{{ 'white-check.svg' | asset_url }}" alt="" width="12" height="12" /> Verified Customer</span>
                </div>
              </div>
            </div>
            <div class="banner-review">
              <div class="br-left"><img src="{{ 'br-img1.png' | asset_url }}" alt="" width="52" height="52" /></div>
              <div class="br-right">
                <p>"Revitae has completely transformed my mood and focus. <span class="bold">I feel like myself again for the first time in ages."</span></p>
