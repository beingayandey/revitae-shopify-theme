<footer class="site-footer">
  <div class="container">
    <div class="footer-wrapper">
      <!-- Newsletter Section -->
      <div class="footer-newsletter">
        <div class="newsletter-text">
          <h2 class="newsletter-title">
            <span class="italic">{{ section.settings.newsletter_title | default: 'Unlock the Balance Brief' }}</span>
          </h2>
          <p class="newsletter-desc">
            {{ section.settings.newsletter_desc | default: 'Get our 5-Minute Guide to Natural Hormonal Harmony, straight to your inbox.' }}
          </p>
        </div>
        {% form 'customer', class: 'newsletter-form' %}
          <input type="hidden" name="contact[tags]" value="newsletter">
          <div class="newsletter-input-group">
            <input
              type="email"
              name="contact[email]"
              class="newsletter-input"
              placeholder="Enter Email Address"
              required
              aria-label="Enter Email Address"
            />
            <button type="submit" class="newsletter-btn">Sign Me Up</button>
          </div>
        {% endform %}
      </div>

      <!-- Dashed Horizontal Divider -->
      <div class="footer-dashed-divider" aria-hidden="true"></div>

      <!-- Main Footer Navigation Row -->
      <div class="footer-main-nav">
        <div class="footer-logo-wrap">
          <a href="{{ routes.root_url }}" aria-label="Home">
            {% if section.settings.logo != blank %}
              <img src="{{ section.settings.logo | image_url: width: 200 }}" alt="{{ shop.name }}" class="footer-logo-img" />
            {% else %}
              <img src="{{ 'logo.png' | asset_url }}" alt="{{ shop.name }}" class="footer-logo-img" />
            {% endif %}
          </a>
        </div>
        <nav class="footer-nav-links" aria-label="Footer Navigation">
          <ul>
            {% assign footer_menu = linklists[section.settings.footer_menu] %}
            {% if footer_menu != blank and footer_menu.links.size > 0 %}
              {% for link in footer_menu.links %}
                <li><a href="{{ link.url }}">{{ link.title }}</a></li>
              {% endfor %}
            {% elsif section.settings.footer_menu.links.size > 0 %}
              {% for link in section.settings.footer_menu.links %}
                <li><a href="{{ link.url }}">{{ link.title }}</a></li>
              {% endfor %}
            {% else %}
              <li><a href="{{ routes.all_products_collection_url | default: '#' }}">Shop All Products</a></li>
              <li><a href="#">About Us</a></li>
              <li><a href="#">FAQs</a></li>
              <li><a href="#">Contact Us</a></li>
            {% endif %}
          </ul>
        </nav>
        <div class="footer-social-links">
          {% if section.settings.facebook_url != blank %}
            <a href="{{ section.settings.facebook_url }}" aria-label="Facebook" class="social-icon" target="_blank" rel="noopener">
              <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="currentColor"><path d="M24 12.073c0-6.627-5.373-12-12-12s-12 5.373-12 12c0 5.99 4.388 10.954 10.125 11.854v-8.385H7.078v-3.47h3.047V9.43c0-3.007 1.792-4.669 4.533-4.669 1.312 0 2.686.235 2.686.235v2.953H15.83c-1.491 0-1.956.925-1.956 1.874v2.25h3.328l-.532 3.47h-2.796v8.385C19.612 23.027 24 18.062 24 12.073z"/></svg>
            </a>
          {% endif %}
          {% if section.settings.instagram_url != blank %}
            <a href="{{ section.settings.instagram_url }}" aria-label="Instagram" class="social-icon" target="_blank" rel="noopener">
              <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="currentColor"><path d="M12 2.163c3.204 0 3.584.012 4.85.07 3.252.148 4.771 1.691 4.919 4.919.058 1.265.069 1.645.069 4.849 0 3.205-.012 3.584-.069 4.849-.149 3.225-1.664 4.771-4.919 4.919-1.266.058-1.644.07-4.85.07-3.204 0-3.584-.012-4.849-.07-3.26-.149-4.771-1.699-4.919-4.92-.058-1.265-.07-1.644-.07-4.849 0-3.204.013-3.583.07-4.849.149-3.227 1.664-4.771 4.919-4.919 1.266-.057 1.645-.069 4.849-.069zm0-2.163c-3.259 0-3.667.014-4.947.072-4.358.2-6.78 2.618-6.98 6.98-.059 1.281-.073 1.689-.073 4.948 0 3.259.014 3.668.072 4.948.2 4.358 2.618 6.78 6.98 6.98 1.281.058 1.689.072 4.948.072 3.259 0 3.668-.014 4.948-.072 4.354-.2 6.782-2.618 6.979-6.98.059-1.28.073-1.689.073-4.948 0-3.259-.014-3.667-.072-4.947-.196-4.354-2.617-6.78-6.979-6.98-1.281-.059-1.69-.073-4.949-.073zm0 5.838c-3.403 0-6.162 2.759-6.162 6.162s2.759 6.163 6.162 6.163 6.162-2.759 6.162-6.163c0-3.403-2.759-6.162-6.162-6.162zm0 10.162c-2.209 0-4-1.79-4-4 0-2.209 1.791-4 4-4s4 1.791 4 4c0 2.21-1.791 4-4 4zm6.406-11.845c-.796 0-1.441.645-1.441 1.44s.645 1.44 1.441 1.44c.795 0 1.439-.645 1.439-1.44s-.644-1.44-1.439-1.44z"/></svg>
            </a>
          {% endif %}
          {% if section.settings.tiktok_url != blank %}
            <a href="{{ section.settings.tiktok_url }}" aria-label="TikTok" class="social-icon" target="_blank" rel="noopener">
              <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="currentColor"><path d="M12.525.02c1.31-.02 2.61-.01 3.91-.02.08 1.53.63 3.09 1.75 4.17 1.12 1.11 2.7 1.62 4.24 1.79v4.03c-1.44-.05-2.89-.35-4.2-.97-.57-.26-1.1-.59-1.62-.93-.01 2.92.01 5.84-.02 8.75-.08 1.4-.54 2.79-1.35 3.94-1.31 1.92-3.58 3.17-5.91 3.21-1.43.08-2.86-.31-4.08-1.03-2.02-1.19-3.44-3.37-3.65-5.71-.02-.5-.03-1-.01-1.49.18-1.9 1.12-3.72 2.58-4.96 1.66-1.44 3.98-2.13 6.15-1.72.02 1.48-.04 2.96-.04 4.44-.99-.32-2.15-.23-3.02.37-.82.56-1.36 1.51-1.41 2.51-.12 1.44.72 2.87 2.05 3.4 1.18.49 2.58.33 3.61-.41.87-.6 1.39-1.61 1.41-2.67.04-4.83.02-9.66.02-14.49z"/></svg>
            </a>
          {% endif %}
        </div>
      </div>

      <!-- Bottom Copyright Row -->
      <div class="footer-bottom-row">
        <div class="footer-copyright">
          <p>&copy; {{ 'now' | date: '%Y' }} {{ shop.name }}. {{ section.settings.copyright_text | default: 'All Rights Reserved.' }}</p>
        </div>
        <div class="footer-legal-links">
          <ul>
            {% assign legal_menu = linklists[section.settings.legal_menu] %}
            {% if legal_menu != blank and legal_menu.links.size > 0 %}
              {% for link in legal_menu.links %}
                <li><a href="{{ link.url }}">{{ link.title }}</a></li>
              {% endfor %}
            {% elsif section.settings.legal_menu.links.size > 0 %}
              {% for link in section.settings.legal_menu.links %}
                <li><a href="{{ link.url }}">{{ link.title }}</a></li>
              {% endfor %}
            {% else %}
              <li><a href="#">Terms &amp; Conditions</a></li>
              <li><a href="#">Privacy Policy</a></li>
              <li><a href="#">Cookie Policy</a></li>
              <li><a href="#">Warranty Info</a></li>
            {% endif %}
          </ul>
        </div>
      </div>
    </div>
  </div>
</footer>

{% schema %}
{
  "name": "Footer",
  "settings": [
    {
      "type": "text",
      "id": "newsletter_title",
      "label": "Newsletter heading",
      "default": "Unlock the Balance Brief"
    },
    {
      "type": "text",
      "id": "newsletter_desc",
      "label": "Newsletter description",
      "default": "Get our 5-Minute Guide to Natural Hormonal Harmony, straight to your inbox."
    },
    {
      "type": "image_picker",
      "id": "logo",
      "label": "Footer logo"
    },
    {
      "type": "link_list",
      "id": "footer_menu",
      "label": "Footer menu",
      "default": "footer"
    },
    {
      "type": "link_list",
      "id": "legal_menu",
      "label": "Legal links menu"
    },
    {
      "type": "text",
      "id": "facebook_url",
      "label": "Facebook URL",
      "default": "#"
    },
    {
      "type": "text",
      "id": "instagram_url",
      "label": "Instagram URL",
      "default": "#"
    },
    {
      "type": "text",
      "id": "tiktok_url",
      "label": "TikTok URL",
      "default": "#"
    },
    {
      "type": "text",
      "id": "copyright_text",
      "label": "Copyright text",
      "default": "All Rights Reserved."
    }
  ]
}
{% endschema %}
